# 依赖
node_modules/

# 系统文件
.DS_Store
Thumbs.db

# WorkBuddy 本地记忆/工作日志（agent 开发记录，本机私有，不与他人共享，不进版本管理）
.workbuddy/

# 音频：只放行内置示范曲（曲库功能依赖它们），其余音频一律不入库
*.mid
!demo/*.mid

# 第三方资产：默认整体不入库，再按白名单逐项放行。
# basic-pitch 放行的是打了本地化补丁的 4 个源文件与其模型权重；
# tfjs 是 AI 转谱运行时的浏览器构建（UMD，浏览器 <script> 直引）。
vendor/*
!vendor/basic-pitch
vendor/basic-pitch/*
!vendor/basic-pitch/index.js
!vendor/basic-pitch/inference.js
!vendor/basic-pitch/matchers.js
!vendor/basic-pitch/toMidi.js
!vendor/basic-pitch/model
!vendor/tfjs
vendor/tfjs/*
!vendor/tfjs/tf.min.js
!vendor/soundfonts

# 本地素材与导出：运行时或调试产生，不入库
*.wav
samples/
logs/
archives/
*.webm
live-debug*.json

# 日志导出
*.log
